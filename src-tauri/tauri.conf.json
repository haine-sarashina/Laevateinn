{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laevateinn",
  "version": "0.3.6",
  "identifier": "com.haine.laevateinn",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Laevateinn",
        "width": 1200,
        "height": 800,
        "maximized": false,
        "decorations": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://oauth2.googleapis.com https://www.googleapis.com https://accounts.google.com; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/haine-sarashina/Laevateinn/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGQjU2MzM5RjQ3MjMwNkQKUldSdE1ITDBPV08xbndqNGZDWUgreXhSbm41aUdOZDA4a3RYR3duSG5EdGdDRkNhSkd5UkorTDIK"
    }
  }
}
