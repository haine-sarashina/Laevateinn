{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "laevateinn-mail",
  "version": "0.1.2",
  "identifier": "com.haine.laevateinn-mail",
  "build": {
    "beforeDevCommand": "pnpm vite-dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Laevateinn v0.1.2",
        "width": 1200,
        "height": 800,
        "maximized": false,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://oauth2.googleapis.com https://www.googleapis.com https://accounts.google.com; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}